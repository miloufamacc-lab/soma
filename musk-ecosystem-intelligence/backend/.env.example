# Musk Ecosystem Intelligence - Environment Configuration
# Copy this file to .env and fill in your actual values

# REQUIRED API Keys
# Get your GuruFocus API key from: https://www.gurufocus.com/api
GURUFOCUS_API_KEY=your_gurufocus_api_key_here

# OPTIONAL API Keys
# Get your Finnhub API key from: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Get your FRED API key from: https://fredaccount.stlouisfed.org/login
FRED_API_KEY=your_fred_api_key_here

# Get your News API key from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Cache TTL Settings (in seconds)
PRICE_CACHE_TTL=300
NEWS_CACHE_TTL=1800
FINANCIAL_CACHE_TTL=7200
ECONOMIC_CACHE_TTL=3600
PROFILE_CACHE_TTL=86400

# Refresh Interval Settings (in seconds)
PRICE_REFRESH_INTERVAL=300
NEWS_REFRESH_INTERVAL=1800
FINANCIAL_REFRESH_INTERVAL=7200
ECONOMIC_REFRESH_INTERVAL=3600
PROFILE_REFRESH_INTERVAL=86400

# Application Metadata
APP_NAME=Musk Ecosystem Intelligence
APP_VERSION=1.0.0
